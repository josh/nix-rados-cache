tail-logs
create-pool

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --chunk-size 64K --stripe-size 262144 --log-file server.log &server&
wait4http http://127.0.0.1:$PORT/nix-cache-info

mkdir fixture
bin-file fixture/blob 1000000 roundtrip
nar-pack fixture payload.nar
exec zstd -q payload.nar -o payload.nar.zst
exec xz -k payload.nar

exec curl --silent --write-out '%{http_code}' --upload-file payload.nar http://127.0.0.1:$PORT/nar/raw.nar
stdout '^201$'
wait4log 'msg=request method=PUT path=/nar/raw.nar status=201 .* rados_calls=29' server.log
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
stdout '^nar/raw\.nar$'
! stdout '^nar/raw\.nar\.'
stdout -count=18 '^chunk/[0-9a-f]{64}$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr nar/raw.nar codec
stdout '^none$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr nar/raw.nar striper.size
stdout '^1000280$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr nar/raw.nar access_count
stdout '^1$'

exec curl --silent --head http://127.0.0.1:$PORT/nar/raw.nar
stdout 'HTTP/1.1 200'
stdout 'Content-Length: 1000280'
exec curl --silent --fail --output downloaded.nar http://127.0.0.1:$PORT/nar/raw.nar
bin-cmp payload.nar downloaded.nar
wait4log 'msg=request method=GET path=/nar/raw.nar status=200 .* resp_bytes=1000280 .* access_count=3' server.log

exec curl --silent --write-out '%{http_code}' --upload-file payload.nar http://127.0.0.1:$PORT/nar/raw.nar
stdout '^200$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr nar/raw.nar access_count
stdout '^4$'

exec curl --silent --write-out '%{http_code}' --upload-file payload.nar.zst http://127.0.0.1:$PORT/nar/z.nar.zst
stdout '^201$'
wait4log 'msg=request method=PUT path=/nar/z.nar.zst status=201 .* rados_calls=65' server.log
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
stdout '^nar/z\.nar\.zst$'
stdout -count=18 '^chunk/'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr nar/z.nar.zst codec
stdout '^zstd$'
exec curl --silent --fail --output downloaded.nar.zst http://127.0.0.1:$PORT/nar/z.nar.zst
exec zstd -q -d downloaded.nar.zst -o unpacked.nar
bin-cmp payload.nar unpacked.nar

exec curl --silent --write-out '%{http_code}' --upload-file payload.nar.xz http://127.0.0.1:$PORT/nar/x.nar.xz
stdout '^201$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
stdout '^nar/x\.nar\.xz\.0000000000000000$'
! stdout '^nar/x\.nar\.xz$'
exec curl --silent --fail --output downloaded.nar.xz http://127.0.0.1:$PORT/nar/x.nar.xz
bin-cmp payload.nar.xz downloaded.nar.xz

! exec curl --silent --max-time 2 --header 'Content-Length: 2000000' --upload-file payload.nar http://127.0.0.1:$PORT/nar/short.nar
wait4log 'msg=request method=PUT path=/nar/short.nar status=500' server.log
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
stdout '^nar/short\.nar$'
! exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr nar/short.nar striper.size
exec curl --silent --write-out '%{http_code}' --output /dev/null http://127.0.0.1:$PORT/nar/short.nar
stdout '^404$'

mkdir tiny
cp extra/tiny.txt tiny/tiny.txt
nar-pack tiny tiny.nar
exec sha256sum tiny.nar
capture-output TINY '^([0-9a-f]{64}) '
exec zstd -q tiny.nar -o tiny.nar.zst
exec zstd -q --no-check tiny.nar -o pre
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL put chunk/$TINY pre
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL stat chunk/$TINY
capture-output PRE 'size ([0-9]+)'
backdate chunk/$TINY 2000-01-01T00:00:00Z
exec curl --silent --write-out '%{http_code}' --upload-file tiny.nar http://127.0.0.1:$PORT/nar/tiny.nar
stdout '^201$'
exec curl --silent --write-out '%{http_code}' --upload-file tiny.nar.zst http://127.0.0.1:$PORT/nar/tiny.nar.zst
stdout '^201$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL stat chunk/$TINY
! stdout 'mtime 2000-'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL get chunk/$TINY after
bin-cmp pre after
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr nar/tiny.nar.zst striper.size
stdout '^'$PRE'$'
exec curl --silent --fail --output tiny-downloaded.nar http://127.0.0.1:$PORT/nar/tiny.nar
bin-cmp tiny.nar tiny-downloaded.nar
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL put chunk/$TINY empty
! exec curl --silent --fail --output /dev/null http://127.0.0.1:$PORT/nar/tiny.nar.zst
wait4log 'msg="read chunk" object=nar/tiny.nar.zst chunk=chunk/'$TINY' error="unexpected EOF"' server.log
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL rm chunk/$TINY
! exec curl --silent --fail --output /dev/null http://127.0.0.1:$PORT/nar/tiny.nar
wait4log 'msg="read chunk" object=nar/tiny.nar chunk=chunk/'$TINY' error="rados: ret=-2' server.log

-- extra/tiny.txt --
one chunk
-- empty --
