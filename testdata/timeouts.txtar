tail-logs
create-pool

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --io-timeout 1s --log-file server.log &server&
wait4http http://127.0.0.1:$PORT/nix-cache-info

bin-file big.nar.xz 41943040
exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file big.nar.xz http://127.0.0.1:$PORT/nar/big.nar.xz
stdout '^201$'

! exec curl --silent --max-time 3 --limit-rate 1 --output /dev/null http://127.0.0.1:$PORT/nar/big.nar.xz
wait4log 'msg="write response" object=nar/big.nar.xz error=".*i/o timeout' server.log
exec curl --silent --fail --output downloaded.nar.xz http://127.0.0.1:$PORT/nar/big.nar.xz
bin-cmp big.nar.xz downloaded.nar.xz

http-hold http://127.0.0.1:$PORT/nar/stalled.nar.xz 1000
wait4log 'msg=request method=PUT path=/nar/stalled.nar.xz status=500' server.log
wait4log 'object=nar/stalled.nar.xz error=".*i/o timeout' server.log
rados-object-count nar/stalled
stdout '^0$'
