tail-logs
create-pool

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --log-file server.log &server&
wait4http http://127.0.0.1:$PORT/nix-cache-info

bin-file big.narinfo 16777217

exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file big.narinfo http://127.0.0.1:$PORT/big.narinfo
stdout '^413$'
wait4log 'msg=request method=PUT path=/big.narinfo status=413 .* rados_calls=0' server.log

rados-object-count ''
stdout '^0$'
