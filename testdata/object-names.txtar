tail-logs
create-pool

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --log-file server.log &server&
wait4http http://127.0.0.1:$PORT/nix-cache-info

exec curl --silent --write-out '%{http_code}' --output /dev/null http://127.0.0.1:$PORT/foo
stdout '^404$'
wait4log 'msg=request method=GET path=/foo status=404 .* rados_calls=0' server.log

exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file body http://127.0.0.1:$PORT/foo
stdout '^404$'

exec curl --silent --write-out '%{http_code}' --output /dev/null http://127.0.0.1:$PORT/a%20b.narinfo
stdout '^404$'

exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file body http://127.0.0.1:$PORT/nar/a%20b
stdout '^404$'

exec curl --silent --write-out '%{http_code}' --output /dev/null http://127.0.0.1:$PORT/
stdout '^404$'

exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
! stdout '^.'

exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file body http://127.0.0.1:$PORT/log/abc123-hello.drv
stdout '^201$'
exec curl --silent --fail --output log.out http://127.0.0.1:$PORT/log/abc123-hello.drv
cmp body log.out
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
stdout -count=1 '^log/'

bin-file big.log 4096
exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file big.log http://127.0.0.1:$PORT/log/big.drv
stdout '^201$'
exec curl --silent --compressed --dump-header zstd.txt --output big.out http://127.0.0.1:$PORT/log/big.drv
grep 'Content-Encoding: zstd' zstd.txt
grep 'Vary: Accept-Encoding' zstd.txt
bin-cmp big.log big.out
exec curl --silent -H 'Accept-Encoding: gzip' --dump-header gzip.txt --output gzip.out http://127.0.0.1:$PORT/log/big.drv
! grep 'Content-Encoding' gzip.txt
bin-cmp big.log gzip.out
exec curl --silent --head --compressed http://127.0.0.1:$PORT/log/big.drv
stdout 'Content-Encoding: zstd'
! stdout 'Content-Length: 4096'
exec curl --silent --dump-header plain.txt --output plain.out http://127.0.0.1:$PORT/log/big.drv
! grep 'Content-Encoding' plain.txt
bin-cmp big.log plain.out
exec curl --silent --compressed --dump-header small.txt --output /dev/null http://127.0.0.1:$PORT/log/abc123-hello.drv
! grep 'Content-Encoding' small.txt

exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file body http://127.0.0.1:$PORT/build-trace-v2/abc123-hello.drv/out.doi
stdout '^404$'
kill -INT server
wait

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --ca-derivations --log-file server.log &ca&
wait4http http://127.0.0.1:$PORT/nix-cache-info
exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file body http://127.0.0.1:$PORT/build-trace-v2/abc123-hello.drv/out.doi
stdout '^201$'
exec curl --silent --fail --output doi.out http://127.0.0.1:$PORT/build-trace-v2/abc123-hello.drv/out.doi
cmp body doi.out
exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file body http://127.0.0.1:$PORT/build-trace-v2/abc123-hello.drv/out.txt
stdout '^404$'
exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file body http://127.0.0.1:$PORT/build-trace-v2/a%20b.drv/out.doi
stdout '^404$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
stdout -count=1 '^build-trace-v2/'

exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file body http://127.0.0.1:$PORT/abc123.ls
stdout '^201$'
exec curl --silent --fail --output ls.out http://127.0.0.1:$PORT/abc123.ls
cmp body ls.out

-- body --
rejected
