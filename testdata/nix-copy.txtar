tail-logs
create-pool

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --log-file server.log &server&
wait4http http://127.0.0.1:$PORT/nix-cache-info

exec nix store add-path --store $WORK/store1 --name hello fixture
stdout '^/nix/store/9sc0rbaa4s1snb6bjs4qz47qalf50p4v-hello$'

exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT /nix/store/9sc0rbaa4s1snb6bjs4qz47qalf50p4v-hello

rados-object-count nar/
stdout '^1$'
rados-object-count ''
stdout '^2$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL listxattr 9sc0rbaa4s1snb6bjs4qz47qalf50p4v.narinfo
stdout '^created$'

exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 /nix/store/9sc0rbaa4s1snb6bjs4qz47qalf50p4v-hello
cmp fixture/hello.txt $WORK/store2/nix/store/9sc0rbaa4s1snb6bjs4qz47qalf50p4v-hello/hello.txt
cmp fixture/bin/greet $WORK/store2/nix/store/9sc0rbaa4s1snb6bjs4qz47qalf50p4v-hello/bin/greet
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr 9sc0rbaa4s1snb6bjs4qz47qalf50p4v.narinfo access_count
stdout '^[1-9][0-9]*$'
wait4log 'msg=request method=GET path=/nar/[^ ]+ status=200 .* access_count=1' server.log

exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT /nix/store/9sc0rbaa4s1snb6bjs4qz47qalf50p4v-hello

rados-object-count ''
stdout '^2$'

mkdir bigfixture
bin-file bigfixture/blob 17000000
exec nix store add-path --store $WORK/store1 --name big bigfixture
capture-output BIG
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT $BIG
rados-object-count nar/
stdout '^3$'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $BIG
cmp bigfixture/blob $WORK/store2$BIG/blob

-- fixture/hello.txt --
hello from nix-rados-cache
-- fixture/bin/greet --
#!/bin/sh
echo hi
