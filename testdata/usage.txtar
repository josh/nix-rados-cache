! exec nix-rados-cache
stderr 'pool is required'

! exec nix-rados-cache --pool no-such-pool
stderr 'open pool'

! exec nix-rados-cache gc
stderr 'pool is required'

! exec nix-rados-cache gc --pool no-such-pool
stderr 'open pool'

! exec nix-rados-cache gc --pool no-such-pool --min-free 10X
stderr 'invalid size'

! exec nix-rados-cache gc --pool no-such-pool --priority newest
stderr 'priority'

! exec nix-rados-cache --pool no-such-pool --stripe-size 0
stderr 'stripe-size'

! exec nix-rados-cache --pool no-such-pool --max-uploads 0
stderr 'max-uploads'

! exec nix-rados-cache --pool no-such-pool --chunk-size 3M
stderr 'chunk-size'

! exec nix-rados-cache --pool no-such-pool --upstream cache.nixos.org
stderr 'invalid upstream'

! exec nix-rados-cache --pool no-such-pool --trusted-public-key bogus
stderr 'invalid trusted public key'

! exec nix-rados-cache --pool no-such-pool --log-file $WORK/nonexistent/server.log
stderr 'open log file'

! exec nix-rados-cache --pool no-such-pool --config $WORK/nonexistent.json
stderr 'no such file'

! exec nix-rados-cache --pool no-such-pool --config bad.json
stderr 'unexpected end of JSON input'

! exec nix-rados-cache --pool no-such-pool --config unknown.json
stderr 'no such flag'

! exec nix-rados-cache --pool no-such-pool --config badvalue.json
stderr 'stripe-size: parse error'

! exec nix-rados-cache --pool no-such-pool --config null.json
stderr 'log-file: unsupported value null'

! exec nix-rados-cache --config pool.json
stderr 'open pool'

env CEPH_CONF=$WORK/empty-ceph.conf
! exec nix-rados-cache --pool no-such-pool
stderr 'connect to ceph'

env CEPH_CONF=/nonexistent
! exec nix-rados-cache --pool no-such-pool
stderr 'read ceph config'

-- empty-ceph.conf --
[global]
-- bad.json --
{
-- unknown.json --
{"bogus": 1}
-- badvalue.json --
{"stripe-size": "big"}
-- null.json --
{"log-file": null}
-- pool.json --
{"pool": "no-such-pool"}
