exec nix store add-path --store $WORK/store1 --name c-compress c-compress
capture-output C_COMPRESS
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=compress $C_COMPRESS
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_COMPRESS
stdout '"compression":"compress"'
stdout '"url":"nar/[0-9a-z]+\.nar"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_COMPRESS
cmp c-compress/f.txt $WORK/store2$C_COMPRESS/f.txt

