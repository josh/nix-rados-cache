exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_ZSTD
stdout '"compression":"zstd"'
stdout '"url":"nar/[0-9a-z]+\.nar\.zst"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_ZSTD
cmp c-zstd/f.txt $WORK/store2$C_ZSTD/f.txt

exec nix store add-path --store $WORK/store1 --name c-br c-br
capture-output C_BR
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=br $C_BR
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_BR
stdout '"compression":"br"'
stdout '"url":"nar/[0-9a-z]+\.nar\.br"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_BR
cmp c-br/f.txt $WORK/store2$C_BR/f.txt

