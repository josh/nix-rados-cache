exec nix store add-path --store $WORK/store1 --name c-parallel c-parallel
capture-output C_PARALLEL
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=zstd&parallel-compression=true $C_PARALLEL
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_PARALLEL
stdout '"compression":"zstd"'
stdout '"url":"nar/[0-9a-z]+\.nar\.zst"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_PARALLEL
cmp c-parallel/f.txt $WORK/store2$C_PARALLEL/f.txt

