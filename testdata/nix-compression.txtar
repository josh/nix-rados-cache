cmp c-xz-parallel/f.txt $WORK/store2$C_XZ_PARALLEL/f.txt

mkdir c-big
bin-file c-big/blob 17000000
exec nix store add-path --store $WORK/store1 --name c-big c-big
capture-output C_BIG
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=zstd $C_BIG
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_BIG
stdout '"compression":"zstd"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_BIG
cmp c-big/blob $WORK/store2$C_BIG/blob

rados-object-count nar/
stdout '^18$'

-- c-zstd-19/f.txt --
codec c-zstd-19
-- c-gzip-9/f.txt --
codec c-gzip-9
-- c-bzip2-9/f.txt --
codec c-bzip2-9
-- c-br-11/f.txt --
codec c-br-11
-- c-xz-parallel/f.txt --
codec c-xz-parallel
-- c-xz/f.txt --
codec c-xz
-- c-bzip2/f.txt --
codec c-bzip2
-- c-gzip/f.txt --
codec c-gzip
-- c-zstd/f.txt --
codec c-zstd
-- c-br/f.txt --
codec c-br
-- c-lzip/f.txt --
codec c-lzip
-- c-compress/f.txt --
codec c-compress
-- c-lzma/f.txt --
codec c-lzma
-- c-none/f.txt --
codec c-none
-- c-level/f.txt --
codec c-level
-- c-parallel/f.txt --
codec c-parallel
