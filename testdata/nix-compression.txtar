capture-output C_NONE
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=none $C_NONE
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_NONE
stdout '"compression":"none"'
stdout '"url":"nar/[0-9a-z]+\.nar"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_NONE
cmp c-none/f.txt $WORK/store2$C_NONE/f.txt

exec nix store add-path --store $WORK/store1 --name c-level c-level
capture-output C_LEVEL
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=xz&compression-level=9 $C_LEVEL
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_LEVEL
stdout '"compression":"xz"'
stdout '"url":"nar/[0-9a-z]+\.nar\.xz"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_LEVEL
