capture-output C_ZSTD_19
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=zstd&compression-level=19 $C_ZSTD_19
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_ZSTD_19
stdout '"compression":"zstd"'
stdout '"url":"nar/[0-9a-z]+\.nar\.zst"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_ZSTD_19
