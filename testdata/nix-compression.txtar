capture-output C_LZMA
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=lzma $C_LZMA
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_LZMA
stdout '"compression":"lzma"'
stdout '"url":"nar/[0-9a-z]+\.nar"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_LZMA
