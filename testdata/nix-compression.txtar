capture-output C_GZIP_9
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=gzip&compression-level=9 $C_GZIP_9
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_GZIP_9
stdout '"compression":"gzip"'
stdout '"url":"nar/[0-9a-z]+\.nar"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_GZIP_9
cmp c-gzip-9/f.txt $WORK/store2$C_GZIP_9/f.txt

exec nix store add-path --store $WORK/store1 --name c-bzip2-9 c-bzip2-9
capture-output C_BZIP2_9
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=bzip2&compression-level=9 $C_BZIP2_9
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_BZIP2_9
stdout '"compression":"bzip2"'
stdout '"url":"nar/[0-9a-z]+\.nar\.bz2"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_BZIP2_9
cmp c-bzip2-9/f.txt $WORK/store2$C_BZIP2_9/f.txt

exec nix store add-path --store $WORK/store1 --name c-br-11 c-br-11
capture-output C_BR_11
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=br&compression-level=11 $C_BR_11
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_BR_11
stdout '"compression":"br"'
stdout '"url":"nar/[0-9a-z]+\.nar\.br"'
exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $C_BR_11
cmp c-br-11/f.txt $WORK/store2$C_BR_11/f.txt

exec nix store add-path --store $WORK/store1 --name c-xz-parallel c-xz-parallel
capture-output C_XZ_PARALLEL
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=xz&parallel-compression=true $C_XZ_PARALLEL
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $C_XZ_PARALLEL
stdout '"compression":"xz"'
stdout '"url":"nar/[0-9a-z]+\.nar\.xz"'
