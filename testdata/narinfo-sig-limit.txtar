tail-logs
create-pool

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --log-file server.log &server&
wait4http http://127.0.0.1:$PORT/nix-cache-info

exec seq -f 'Sig: p%06g:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' 1 167700
cp stdout pad.txt
exec cat head.narinfo pad.txt
cp stdout full.narinfo
exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file full.narinfo http://127.0.0.1:$PORT/siglimit000000000000000000000000.narinfo
stdout '^201$'

exec seq -f 'Sig: q%06g:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' 1 100
cp stdout more.txt
exec cat head.narinfo more.txt
cp stdout more.narinfo
exec curl --silent --write-out '%{http_code}' --output /dev/null --upload-file more.narinfo http://127.0.0.1:$PORT/siglimit000000000000000000000000.narinfo
stdout '^413$'
wait4log 'msg=request method=PUT path=/siglimit000000000000000000000000.narinfo status=413' server.log

exec curl --silent --fail --output stored.narinfo http://127.0.0.1:$PORT/siglimit000000000000000000000000.narinfo
bin-cmp full.narinfo stored.narinfo

-- head.narinfo --
StorePath: /nix/store/siglimit000000000000000000000000-x
URL: nar/x.nar
