tail-logs
create-pool

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --stripe-size 65536 --log-file server.log &striped&
wait4http http://127.0.0.1:$PORT/nix-cache-info

bin-file payload.nar.xz 100000 hash
exec nix hash file --base32 --type sha256 payload.nar.xz
capture-output HASH '^([0-9a-z]{52})$'
bin-file other.nar.xz 100000 other
exec nix hash file --base32 --type sha256 other.nar.xz
capture-output OTHER '^([0-9a-z]{52})$'

exec curl --silent --write-out '%{http_code}' --upload-file payload.nar.xz http://127.0.0.1:$PORT/nar/$HASH.nar.xz
stdout '^201$'
exec curl --silent --fail --output downloaded.nar.xz http://127.0.0.1:$PORT/nar/$HASH.nar.xz
bin-cmp payload.nar.xz downloaded.nar.xz

exec curl --silent --write-out '%{http_code}' --upload-file payload.nar.xz http://127.0.0.1:$PORT/nar/$OTHER.nar.xz
stdout '^NAR hash mismatch\n400$'
wait4log 'msg=request method=PUT path=/nar/'$OTHER'.nar.xz status=400' server.log
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
stdout -count=2 '^nar/'$HASH'\.nar\.xz\.'
! stdout '^nar/'$OTHER'\.nar\.xz\.0000000000000000$'
stdout -count=1 '^nar/'$OTHER'\.nar\.xz\.0000000000000001$'
exec curl --silent --write-out '%{http_code}' --output /dev/null http://127.0.0.1:$PORT/nar/$OTHER.nar.xz
stdout '^404$'

exec curl --silent --write-out '%{http_code}' --upload-file other.nar.xz http://127.0.0.1:$PORT/nar/$OTHER.nar
stdout '^201$'
exec curl --silent --write-out '%{http_code}' --upload-file other.nar.xz http://127.0.0.1:$PORT/nar/$HASH.nar.xz
stdout '^200$'
exec curl --silent --write-out '%{http_code}' --upload-file other.nar.xz http://127.0.0.1:$PORT/nar/unnamed.nar.xz
stdout '^201$'
exec curl --silent --write-out '%{http_code}' --upload-file other.nar.xz http://127.0.0.1:$PORT/nar/$HASH
stdout '^201$'

kill -INT striped
wait

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --chunk-size 64K --stripe-size 262144 --log-file server.log &chunked&
wait4http http://127.0.0.1:$PORT/nix-cache-info

mkdir fixture
bin-file fixture/blob 1000000 chunked
nar-pack fixture payload.nar
exec nix hash file --base32 --type sha256 payload.nar
capture-output RAW '^([0-9a-z]{52})$'
exec zstd -q payload.nar -o payload.nar.zst
exec nix hash file --base32 --type sha256 payload.nar.zst
capture-output ZST '^([0-9a-z]{52})$'

exec curl --silent --write-out '%{http_code}' --upload-file payload.nar http://127.0.0.1:$PORT/nar/$ZST.nar
stdout '^NAR hash mismatch\n400$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL stat nar/$ZST.nar
! exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr nar/$ZST.nar striper.size
exec curl --silent --write-out '%{http_code}' --output /dev/null http://127.0.0.1:$PORT/nar/$ZST.nar
stdout '^404$'
exec curl --silent --write-out '%{http_code}' --upload-file payload.nar.zst http://127.0.0.1:$PORT/nar/$RAW.nar.zst
stdout '^NAR hash mismatch\n400$'

exec curl --silent --write-out '%{http_code}' --upload-file payload.nar http://127.0.0.1:$PORT/nar/$RAW.nar
stdout '^201$'
exec curl --silent --write-out '%{http_code}' --upload-file payload.nar.zst http://127.0.0.1:$PORT/nar/$ZST.nar.zst
stdout '^201$'
exec curl --silent --fail --output raw.nar http://127.0.0.1:$PORT/nar/$RAW.nar
bin-cmp payload.nar raw.nar
exec curl --silent --fail --output served.nar.zst http://127.0.0.1:$PORT/nar/$ZST.nar.zst
exec zstd -q -d served.nar.zst -o served.nar
bin-cmp payload.nar served.nar
