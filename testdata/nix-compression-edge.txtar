tail-logs
create-pool

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --log-file server.log &server&
wait4http http://127.0.0.1:$PORT/nix-cache-info

exec nix store add-path --store $WORK/store1 --name corrupt corrupt
capture-output CORRUPT
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=zstd $CORRUPT
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $CORRUPT
capture-output NAR "url":"(nar/[^"]+)"
capture-output SIZE "downloadSize":([0-9]+)
bin-file garbage $SIZE
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL put $NAR.0000000000000000 garbage
! exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $CORRUPT
stderr 'input compression not recognized'
! exists $WORK/store2$CORRUPT

bin-file short 100
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL put $NAR.0000000000000000 short
! exec nix copy --no-check-sigs --from http://127.0.0.1:$PORT --to $WORK/store2 $CORRUPT
stderr 'Transferred a partial file'
wait4log 'msg="read stripe" object=nar/[^ ]+ offset=100' server.log
! exists $WORK/store2$CORRUPT

exec nix store add-path --store $WORK/store1 --name codec codec
capture-output CODEC
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=xz $CODEC
rados-object-count nar/
stdout '^2$'
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=zstd $CODEC
rados-object-count nar/
stdout '^2$'
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $CODEC
stdout '"compression":"xz"'
stdout '"url":"nar/[0-9a-z]+\.nar\.xz"'


exec nix store add-path --store $WORK/store1 --name sized sized
capture-output SIZED
exec nix copy --from $WORK/store1 --to http://127.0.0.1:$PORT?compression=bzip2 $SIZED
exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 $SIZED
capture-output SIZED_NAR "url":"(nar/[^"]+)"
capture-output SIZED_FILE "downloadSize":([0-9]+)
capture-output SIZED_NAR_SIZE "narSize":([0-9]+)
exec curl --silent --head http://127.0.0.1:$PORT/$SIZED_NAR
stdout Content-Length:.$SIZED_FILE
! stdout Content-Length:.$SIZED_NAR_SIZE
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr $SIZED_NAR.0000000000000000 striper.size
stdout ^$SIZED_FILE$

-- corrupt/f.txt --
this NAR will be corrupted in the pool
-- codec/f.txt --
pushed as xz, then again as zstd
-- sized/f.txt --
compressed size differs from NAR size, and this line pads it out so bzip2 has something to squeeze
