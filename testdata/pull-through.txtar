[!net] skip 'no network'

tail-logs
create-pool

exec nix-rados-cache --pool $NIX_RADOS_CACHE_POOL --listen 127.0.0.1:$PORT --upstream https://cache.nixos.org --log-file server.log &server&
wait4http http://127.0.0.1:$PORT/nix-cache-info

exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 /nix/store/yh6x9ia5kxxw3w90vkb09vqgfvhb416k-hello-2.12.1
stdout '"narSize":226560'
wait4log 'msg=request method=GET path=/yh6x9ia5kxxw3w90vkb09vqgfvhb416k.narinfo status=200 .* upstream=https://cache.nixos.org' server.log
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
stdout -count=1 '^yh6x9ia5kxxw3w90vkb09vqgfvhb416k\.narinfo'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr yh6x9ia5kxxw3w90vkb09vqgfvhb416k.narinfo upstream
stdout '^https://cache.nixos.org$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL get yh6x9ia5kxxw3w90vkb09vqgfvhb416k.narinfo -
stdout '^Sig: cache.nixos.org-1:'

exec nix path-info --store http://127.0.0.1:$PORT --json --json-format 2 /nix/store/yh6x9ia5kxxw3w90vkb09vqgfvhb416k-hello-2.12.1
stdout '"narSize":226560'
wait4log 'msg=request method=GET path=/yh6x9ia5kxxw3w90vkb09vqgfvhb416k.narinfo status=200 .* upstream=""' server.log

! exec nix path-info --store http://127.0.0.1:$PORT /nix/store/00000000000000000000000000000000-nothing
wait4log 'msg=request method=GET path=/00000000000000000000000000000000.narinfo status=404' server.log
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
stdout -count=1 '^.'

exec curl --silent --head http://127.0.0.1:$PORT/nar/1qh6kihqm794qwapdv3zpr523qcxin6l4j0yqfyg5hfxzqy6l2na.nar.xz
stdout 'HTTP/1.1 200'
stdout 'Content-Length: 50204'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
! stdout '^nar/'

exec nix copy --from http://127.0.0.1:$PORT --to $WORK/store2 --trusted-public-keys cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY= /nix/store/yh6x9ia5kxxw3w90vkb09vqgfvhb416k-hello-2.12.1
exists $WORK/store2/nix/store/yh6x9ia5kxxw3w90vkb09vqgfvhb416k-hello-2.12.1/bin/hello
wait4log 'msg=request method=GET path=/nar/1qh6kihqm794qwapdv3zpr523qcxin6l4j0yqfyg5hfxzqy6l2na.nar.xz status=200 .* upstream=https://cache.nixos.org' server.log
wait4log 'msg=pulled object=nar/1qh6kihqm794qwapdv3zpr523qcxin6l4j0yqfyg5hfxzqy6l2na.nar.xz upstream=https://cache.nixos.org' server.log
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
stdout -count=1 '^nar/1qh6kihqm794qwapdv3zpr523qcxin6l4j0yqfyg5hfxzqy6l2na\.nar\.xz'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL getxattr nar/1qh6kihqm794qwapdv3zpr523qcxin6l4j0yqfyg5hfxzqy6l2na.nar.xz.0000000000000000 upstream
stdout '^https://cache.nixos.org$'
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
cp stdout objects.txt

exec nix copy --from http://127.0.0.1:$PORT --to $WORK/store3 --trusted-public-keys cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY= /nix/store/yh6x9ia5kxxw3w90vkb09vqgfvhb416k-hello-2.12.1
exists $WORK/store3/nix/store/yh6x9ia5kxxw3w90vkb09vqgfvhb416k-hello-2.12.1/bin/hello
wait4log 'msg=request method=GET path=/nar/1qh6kihqm794qwapdv3zpr523qcxin6l4j0yqfyg5hfxzqy6l2na.nar.xz status=200 .* upstream=""' server.log
exec rados --conf $CEPH_CONF --pool $NIX_RADOS_CACHE_POOL ls
cmp stdout objects.txt
